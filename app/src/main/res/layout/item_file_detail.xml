<?xml version="1.0" encoding="utf-8"?>
<!-- Detail view: name (never squeezed to zero width) + type / size / date columns. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:paddingStart="12dp"
    android:paddingEnd="6dp">

    <LinearLayout
        android:id="@+id/rowMain"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minWidth="0dp">

        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_folder_blue"
            android:contentDescription="@string/folder" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="100dp"
            android:layout_marginStart="8dp"
            android:text="文件名"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:ellipsize="middle"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvNew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_new"
            android:text="@string/badge_new"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvType"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:singleLine="true" />

    <TextView
        android:id="@+id/tvSize"
        android:layout_width="66dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:singleLine="true" />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:singleLine="true" />

    <ImageButton
        android:id="@+id/btnOpen"
        android:layout_width="24dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_dot"
        android:scaleType="centerInside"
        android:contentDescription="@string/open_play" />

    <ImageView
        android:id="@+id/cbSelect"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_check_off"
        android:visibility="gone"
        android:contentDescription="@string/menu_select_all" />

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
