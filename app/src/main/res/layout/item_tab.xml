<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tabRoot"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_tab"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/tab_height"
    android:layout_marginEnd="6dp"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/imgTabIcon"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_home"
        android:contentDescription="@string/tab_home" />

    <TextView
        android:id="@+id/tvTabTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="104dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:text="@string/tab_home"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/btnTabClose"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:padding="2dp"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/window_close_all" />
</LinearLayout>
