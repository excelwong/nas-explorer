<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <View
            android:id="@+id/tileBg"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_tile" />

        <ImageView
            android:id="@+id/tileIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_cat_music"
            android:contentDescription="@string/home_cat_music" />

        <TextView
            android:id="@+id/tileBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-6dp"
            android:minWidth="18dp"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:background="@drawable/bg_badge"
            android:textColor="@color/es_blue"
            android:textSize="10sp"
            android:text="0" />
    </FrameLayout>

    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/home_cat_music"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:singleLine="true" />
</LinearLayout>
