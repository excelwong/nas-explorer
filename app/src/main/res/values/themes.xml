<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fixed light theme: the old DayNight theme made TextView text white on white cards on
         some devices, which is why file names were invisible in the SMB directory listing. -->
    <style name="Theme.NasBrowser" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/es_blue</item>
        <item name="colorPrimaryVariant">@color/es_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/es_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/es_blue_dark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>
